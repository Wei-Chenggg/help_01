\f2 \cf2 \strokec2 class Auto_Contour_Params:\
\
    def __init__(\
        self,\
        cnt_count=5,\
        cnt_pts_num=6,\
        fillet_radius=0.8,\
        fillet_pts_num=6,\
        snap_tol=1e-2,\
        min_cnt_area=0.05,\
        clip_to_auto=True,\
        wall_margin=0.2,\
        auto_layer_prefix="AUTO",\
    ):\
        self.cnt_count = int(cnt_count)\
        self.cnt_pts_num = int(cnt_pts_num)\
        self.fillet_radius = float(fillet_radius)\
        self.fillet_pts_num = max(2, int(fillet_pts_num))\
        self.snap_tol = float(snap_tol)\
        self.min_cnt_area = float(min_cnt_area)\
        self.clip_to_auto = bool(clip_to_auto)\
        self.wall_margin = float(wall_margin)\
        self.auto_layer_prefix = str(auto_layer_prefix).upper()\
\
\
class Auto_Contour_Helper:\
\
    def __init__(self, fpath_or_doc, hp=None):\
        self.hp = hp if hp is not None else Auto_Contour_Params()\
        self.fpath = fpath_or_doc if isinstance(fpath_or_doc, str) else "<in-memory-doc>"\
        self.fname = self.fpath.split("/")[-1] if isinstance(fpath_or_doc, str) else "<in-memory-doc>"\
        self.base_poly = None\
        self.auto_poly = None\
        self.solid_poly = None\
        self.bc_segments = []\
        self.probe_circles = []\
        self.auto_bounds = (0.0, 0.0, 10.0, 10.0)\
        self.load_base_dxf(fpath_or_doc)\
\
    def _is_auto_layer(self, layer_name):\
        lname = str(layer_name).strip().upper()\
        prefix = self.hp.auto_layer_prefix\
        return lname == prefix or lname.startswith(prefix + "#") or lname.startswith(prefix + "_")\
\
    def _build_polygon_from_loops(self, loops):\
        if not loops:\
            return Polygon()\
        ordered = sorted(loops, key=lambda arr: FiniteEleMeshHelper._polygon_area(arr), reverse=True)\
        polys = []\
        for arr in ordered:\
            if len(arr) >= 3 and FiniteEleMeshHelper._polygon_area(arr) > 1e-8:\
                p = Polygon(arr).buffer(0.0)\
                if not p.is_empty:\
                    polys.append(p)\
        if not polys:\
            return Polygon()\
        outer = polys[0]\
        holes = []\
        for p in polys[1:]:\
            if outer.contains(p.representative_point()):\
                holes.append(p)\
            else:\
                outer = unary_union([outer, p])\
        if holes:\
            outer = outer.difference(unary_union(holes))\
        return outer.buffer(0.0)\
\
    def load_base_dxf(self, fpath_or_doc):\
        doc = ezdxf.readfile(fpath_or_doc) if isinstance(fpath_or_doc, str) else fpath_or_doc\
        msp = doc.modelspace()\
        raw_lines, _curve_edges, _disp, arc_polys, circle_polys = DXFContourHelper.extract_primitives_from_msp(msp)\
        base_raw_lines = [s for s in raw_lines if not self._is_auto_layer(s.layer)]\
        auto_raw_lines = [s for s in raw_lines if self._is_auto_layer(s.layer)]\
        clean_base_lines = DXFContourHelper.split_and_dedup_lines(\
            base_raw_lines, ContourHyperParams(snap_tol=self.hp.snap_tol)\
        )\
        clean_auto_lines = DXFContourHelper.split_and_dedup_lines(\
            auto_raw_lines, ContourHyperParams(snap_tol=self.hp.snap_tol)\
        )\
        base_segs = []\
        auto_segs = []\
        self.bc_segments = []\
        self.probe_circles = []\
        for s in clean_base_lines:\
            pts = np.array([s.p1, s.p2], dtype=float)\
            base_segs.append((pts, s.layer))\
            if str(s.layer).strip() != "0":\
                self.bc_segments.append((s.p1, s.p2, s.layer))\
        for s in clean_auto_lines:\
            pts = np.array([s.p1, s.p2], dtype=float)\
            auto_segs.append((pts, s.layer))\
        for pts, _handle, layer in arc_polys:\
            arr = np.asarray(pts, dtype=float)\
            if len(arr) < 2:\
                continue\
            if self._is_auto_layer(layer):\
                auto_segs.append((arr, layer))\
            else:\
                base_segs.append((arr, layer))\
                if str(layer).strip() != "0":\
                    for k in range(len(arr) - 1):\
                        p1 = (float(arr[k, 0]), float(arr[k, 1]))\
                        p2 = (float(arr[k + 1, 0]), float(arr[k + 1, 1]))\
                        self.bc_segments.append((p1, p2, layer))\
        base_loops = []\
        auto_loops = []\
        for pts, handle, layer in circle_polys:\
            arr = np.asarray(pts, dtype=float)\
            if len(arr) < 4:\
                continue\
            info = DXFContourHelper.parse_bc_layer(layer)\
            if info.get("type") == "PROBE":\
                cx = float(arr[:, 0].mean())\
                cy = float(arr[:, 1].mean())\
                r = float(np.mean(np.hypot(arr[:, 0] - cx, arr[:, 1] - cy)))\
                self.probe_circles.append(\{\
                    "probe_id": info.get("probe_id", "PROBE#001"),\
                    "layer": layer,\
                    "handle": handle,\
                    "center": (cx, cy),\
                    "radius": r,\
                \})\
                continue\
            loop, _lays = FiniteEleMeshHelper._dedup_with_edge_layers(\
                arr, [layer] * (len(arr) - 1), tol=self.hp.snap_tol\
            )\
            if len(loop) >= 3:\
                if self._is_auto_layer(layer):\
                    auto_loops.append(loop)\
                else:\
                    base_loops.append(loop)\
                    if str(layer).strip() != "0":\
                        for k in range(len(loop)):\
                            p1 = (float(loop[k, 0]), float(loop[k, 1]))\
                            p2 = (float(loop[(k + 1) % len(loop), 0]), float(loop[(k + 1) % len(loop), 1]))\
                            self.bc_segments.append((p1, p2, layer))\
        for loop, _lays in FiniteEleMeshHelper._chain_segments_with_layers(base_segs, snap_tol=self.hp.snap_tol):\
            base_loops.append(loop)\
        for loop, _lays in FiniteEleMeshHelper._chain_segments_with_layers(auto_segs, snap_tol=self.hp.snap_tol):\
            auto_loops.append(loop)\
        self.base_poly = self._build_polygon_from_loops(base_loops)\
        auto_poly_list = [\
            Polygon(lp).buffer(0.0)\
            for lp in auto_loops\
            if len(lp) >= 3 and FiniteEleMeshHelper._polygon_area(lp) > 1e-8\
        ]\
        self.auto_poly = unary_union(auto_poly_list).buffer(0.0) if auto_poly_list else Polygon()\
        if not self.auto_poly.is_empty:\
            self.solid_poly = unary_union([self.base_poly, self.auto_poly]).buffer(0.0)\
            self.auto_bounds = self.auto_poly.bounds\
        else:\
            self.solid_poly = self.base_poly\
            self.auto_bounds = self.base_poly.bounds if not self.base_poly.is_empty else (0.0, 0.0, 10.0, 10.0)\
\
    def _order_cnt_vertices(self, pts):\
        arr = np.asarray(pts, dtype=float)\
        if len(arr) < 3:\
            return arr\
        center = arr.mean(axis=0)\
        angles = np.arctan2(arr[:, 1] - center[1], arr[:, 0] - center[0])\
        order = np.argsort(angles)\
        return arr[order]\
\
    def decode_cnt_vector(self, cnt_input):\
        arr = np.asarray(cnt_input, dtype=float)\
        expected_size = self.hp.cnt_count * self.hp.cnt_pts_num * 2\
        if arr.size == expected_size:\
            return arr.reshape(self.hp.cnt_count, self.hp.cnt_pts_num, 2)\
        if arr.ndim == 3 and arr.shape[1] >= 3 and arr.shape[2] == 2:\
            return arr\
        raise ValueError(f"CNT \uc0\u21443 \u25976 \u32173 \u24230 \u38656 \u28858  (\{self.hp.cnt_count\}, \{self.hp.cnt_pts_num\}, 2) \u25110 \u38263 \u24230  \{expected_size\} \u30340 \u19968 \u32173 \u38499 \u21015 ")\
\
    def random_cnt_vector(self, seed=None, radius_scale=0.18):\
        rng = np.random.default_rng(seed)\
        xmin, ymin, xmax, ymax = self.auto_bounds\
        span = max(xmax - xmin, ymax - ymin, 1.0)\
        active_zone = self.auto_poly if not self.auto_poly.is_empty else self.solid_poly\
        centers = []\
        tries = 0\
        while len(centers) < self.hp.cnt_count and tries < 500:\
            tries += 1\
            cand = rng.uniform([xmin, ymin], [xmax, ymax])\
            if active_zone.is_empty or active_zone.contains( Polygon([cand, cand + [1e-4, 0], cand + [0, 1e-4]]).centroid ):\
                centers.append(cand)\
        while len(centers) < self.hp.cnt_count:\
            centers.append(rng.uniform([xmin, ymin], [xmax, ymax]))\
        out = np.zeros((self.hp.cnt_count, self.hp.cnt_pts_num, 2), dtype=float)\
        base_angles = np.linspace(0.0, 2.0 * math.pi, self.hp.cnt_pts_num, endpoint=False)\
        for i in range(self.hp.cnt_count):\
            ang_jitter = rng.uniform(-0.2, 0.2, size=self.hp.cnt_pts_num)\
            angs = base_angles + ang_jitter\
            rads = rng.uniform(0.04 * span, radius_scale * span, size=self.hp.cnt_pts_num)\
            out[i, :, 0] = centers[i][0] + rads * np.cos(angs)\
            out[i, :, 1] = centers[i][1] + rads * np.sin(angs)\
        return out\
\
    def _fillet_closed_ring(self, ring_pts, radius, arc_pts_num):\
        pts = np.asarray(ring_pts, dtype=float)\
        if len(pts) >= 2 and np.linalg.norm(pts[0] - pts[-1]) <= 1e-7:\
            pts = pts[:-1]\
        clean = [pts[0]] if len(pts) > 0 else []\
        for k in range(1, len(pts)):\
            if np.linalg.norm(pts[k] - clean[-1]) > 1e-6:\
                clean.append(pts[k])\
        if len(clean) >= 2 and np.linalg.norm(clean[0] - clean[-1]) <= 1e-6:\
            clean.pop()\
        pts = np.array(clean, dtype=float)\
        n = len(pts)\
        if n < 3 or radius <= 1e-7:\
            return pts\
        filleted = []\
        for i in range(n):\
            p_prev = pts[(i - 1) % n]\
            p_curr = pts[i]\
            p_next = pts[(i + 1) % n]\
            v1 = p_prev - p_curr\
            v2 = p_next - p_curr\
            len1 = float(np.linalg.norm(v1))\
            len2 = float(np.linalg.norm(v2))\
            if len1 <= 1e-7 or len2 <= 1e-7:\
                filleted.append(p_curr)\
                continue\
            u1 = v1 / len1\
            u2 = v2 / len2\
            cos_theta = float(np.clip(np.dot(u1, u2), -1.0, 1.0))\
            theta = math.acos(cos_theta)\
            half_theta = 0.5 * theta\
            tan_half = math.tan(half_theta)\
            sin_half = math.sin(half_theta)\
            if abs(tan_half) <= 1e-5 or sin_half <= 1e-5 or abs(math.pi - theta) <= 1e-3:\
                filleted.append(p_curr)\
                continue\
            d_ideal = radius / tan_half\
            d_max = 0.45 * min(len1, len2)\
            d_eff = min(d_ideal, d_max)\
            r_eff = d_eff * tan_half\
            if r_eff <= 1e-6 or arc_pts_num < 2:\
                filleted.append(p_curr)\
                continue\
            t1 = p_curr + d_eff * u1\
            t2 = p_curr + d_eff * u2\
            bisector = u1 + u2\
            b_norm = float(np.linalg.norm(bisector))\
            if b_norm <= 1e-7:\
                filleted.append(p_curr)\
                continue\
            bisector = bisector / b_norm\
            center = p_curr + (r_eff / sin_half) * bisector\
            ang1 = math.atan2(t1[1] - center[1], t1[0] - center[0])\
            ang2 = math.atan2(t2[1] - center[1], t2[0] - center[0])\
            delta = (ang2 - ang1 + math.pi) % (2.0 * math.pi) - math.pi\
            angs = ang1 + np.linspace(0.0, delta, arc_pts_num)\
            arc_xy = np.column_stack([center[0] + r_eff * np.cos(angs), center[1] + r_eff * np.sin(angs)])\
            filleted.extend(arc_xy.tolist())\
        res = np.array(filleted, dtype=float)\
        res, _ = FiniteEleMeshHelper._dedup_with_edge_layers(res, ["0"] * len(res), tol=1e-5)\
        return res\
\
    def _fillet_shapely_geom(self, geom, radius, arc_pts_num):\
        if geom is None or geom.is_empty:\
            return Polygon()\
        if isinstance(geom, Polygon):\
            ext_coords = np.asarray(geom.exterior.coords, dtype=float)\
            ext_filleted = self._fillet_closed_ring(ext_coords, radius, arc_pts_num)\
            if len(ext_filleted) < 3:\
                return Polygon()\
            holes_filleted = []\
            for interior in geom.interiors:\
                h_coords = np.asarray(interior.coords, dtype=float)\
                h_filleted = self._fillet_closed_ring(h_coords, radius, arc_pts_num)\
                if len(h_filleted) >= 3:\
                    holes_filleted.append(h_filleted)\
            return Polygon(ext_filleted, holes_filleted).buffer(0.0)\
        if isinstance(geom, MultiPolygon):\
            parts = [self._fillet_shapely_geom(sub, radius, arc_pts_num) for sub in geom.geoms]\
            valid_parts = [p for p in parts if not p.is_empty]\
            return unary_union(valid_parts).buffer(0.0) if valid_parts else Polygon()\
        return Polygon()\
\
    def build_filleted_cnt_geom(self, cnt_input):\
        cnt_arr = self.decode_cnt_vector(cnt_input)\
        raw_polys = []\
        for i in range(len(cnt_arr)):\
            ordered_pts = self._order_cnt_vertices(cnt_arr[i])\
            if len(ordered_pts) < 3:\
                continue\
            poly = Polygon(ordered_pts).buffer(0.0)\
            if not poly.is_empty and poly.area >= self.hp.min_cnt_area:\
                raw_polys.append(poly)\
        if not raw_polys:\
            return Polygon(), []\
        merged_cnt = unary_union(raw_polys).buffer(0.0)\
        if self.hp.clip_to_auto and not self.auto_poly.is_empty:\
            clip_zone = (\
                self.auto_poly.buffer(-self.hp.wall_margin)\
                if self.hp.wall_margin > 0.0\
                else self.auto_poly\
            )\
            if not clip_zone.is_empty:\
                merged_cnt = merged_cnt.intersection(clip_zone).buffer(0.0)\
        elif self.hp.wall_margin > 0.0 and not self.solid_poly.is_empty:\
            safe_zone = self.solid_poly.buffer(-self.hp.wall_margin)\
            if not safe_zone.is_empty:\
                merged_cnt = merged_cnt.intersection(safe_zone).buffer(0.0)\
        filleted_cnt = self._fillet_shapely_geom(\
            merged_cnt, self.hp.fillet_radius, self.hp.fillet_pts_num\
        )\
        return filleted_cnt, raw_polys\
\
    def _assign_edge_layers(self, loop_pts):\
        n = len(loop_pts)\
        layers = ["0"] * n\
        if not self.bc_segments:\
            return layers\
        for i in range(n):\
            p_a = loop_pts[i]\
            p_b = loop_pts[(i + 1) % n]\
            mid = 0.5 * (p_a + p_b)\
            seg_vec = p_b - p_a\
            seg_len = float(np.linalg.norm(seg_vec))\
            if seg_len <= 1e-9:\
                continue\
            seg_dir = seg_vec / seg_len\
            best_layer = "0"\
            best_prio = 0\
            for bp1, bp2, blayer in self.bc_segments:\
                b1 = np.asarray(bp1, dtype=float)\
                b2 = np.asarray(bp2, dtype=float)\
                bv = b2 - b1\
                blen2 = float(np.dot(bv, bv))\
                if blen2 <= 1e-12:\
                    continue\
                bdir = bv / math.sqrt(blen2)\
                if abs(seg_dir[0] * bdir[1] - seg_dir[1] * bdir[0]) > 0.08:\
                    continue\
                t = float(np.clip(np.dot(mid - b1, bv) / blen2, 0.0, 1.0))\
                proj = b1 + t * bv\
                dist = float(np.linalg.norm(mid - proj))\
                if dist <= max(self.hp.snap_tol * 2.5, 1e-2):\
                    prio = DXFEditingHelper.layer_priority(blayer)\
                    if prio > best_prio:\
                        best_prio = prio\
                        best_layer = blayer\
            layers[i] = best_layer\
        return layers\
\
    def generate_sample_geometry(self, cnt_input):\
        filleted_cnt, raw_cnt_polys = self.build_filleted_cnt_geom(cnt_input)\
        if not filleted_cnt.is_empty:\
            final_poly = self.solid_poly.difference(filleted_cnt).buffer(0.0)\
        else:\
            final_poly = self.solid_poly\
        if final_poly.is_empty:\
            raise ValueError("CNT \uc0\u20999 \u32905 \u24460 \u28961 \u21097 \u39192 \u23526 \u24515 \u32080 \u27083 ")\
        if isinstance(final_poly, MultiPolygon):\
            final_poly = max(final_poly.geoms, key=lambda g: g.area)\
        outer_coords = np.asarray(final_poly.exterior.coords, dtype=float)[:-1]\
        outer_coords, _ = FiniteEleMeshHelper._dedup_with_edge_layers(\
            outer_coords, ["0"] * len(outer_coords), tol=self.hp.snap_tol\
        )\
        if FiniteEleMeshHelper._polygon_area_signed(outer_coords) < 0:\
            outer_coords = outer_coords[::-1].copy()\
        outer_layers = self._assign_edge_layers(outer_coords)\
        hole_loops = []\
        hole_layers = []\
        for interior in final_poly.interiors:\
            h_coords = np.asarray(interior.coords, dtype=float)[:-1]\
            h_coords, _ = FiniteEleMeshHelper._dedup_with_edge_layers(\
                h_coords, ["0"] * len(h_coords), tol=self.hp.snap_tol\
            )\
            if len(h_coords) < 3 or FiniteEleMeshHelper._polygon_area(h_coords) <= 1e-6:\
                continue\
            if FiniteEleMeshHelper._polygon_area_signed(h_coords) > 0:\
                h_coords = h_coords[::-1].copy()\
            hole_loops.append(h_coords)\
            hole_layers.append(self._assign_edge_layers(h_coords))\
        return \{\
            "outer_loop": outer_coords,\
            "outer_layers": outer_layers,\
            "hole_loops": hole_loops,\
            "hole_layers": hole_layers,\
            "probe_circles": self.probe_circles,\
            "solid_poly": self.solid_poly,\
            "auto_poly": self.auto_poly,\
            "raw_cnt_polys": raw_cnt_polys,\
            "filleted_cnt_poly": filleted_cnt,\
            "final_poly": final_poly,\
        \}\
\
    def build_sample_doc(self, cnt_input, out_fpath=None):\
        geom = self.generate_sample_geometry(cnt_input)\
        doc = ezdxf.new("R2010")\
        msp = doc.modelspace()\
        all_loops = [(geom["outer_loop"], geom["outer_layers"])] + list(\
            zip(geom["hole_loops"], geom["hole_layers"])\
        )\
        for loop, layers in all_loops:\
            n = len(loop)\
            for i in range(n):\
                p1 = (float(loop[i, 0]), float(loop[i, 1]))\
                p2 = (float(loop[(i + 1) % n, 0]), float(loop[(i + 1) % n, 1]))\
                lay = str(layers[i]) if i < len(layers) else "0"\
                style = DXFEditingHelper.get_layer_style(lay)\
                DXFEditingHelper.ensure_layer(doc, lay, color=style.get("dxf_color", 7))\
                DXFEditingHelper.add_line(msp, p1, p2, lay)\
        for probe in geom["probe_circles"]:\
            lay = str(probe["layer"])\
            style = DXFEditingHelper.get_layer_style(lay)\
            DXFEditingHelper.ensure_layer(doc, lay, color=style.get("dxf_color", 3))\
            msp.add_circle(\
                center=probe["center"],\
                radius=probe["radius"],\
                dxfattribs=\{"layer": lay\},\
            )\
        if out_fpath is not None:\
            doc.saveas(out_fpath)\
        return doc, geom\
\
    def evaluate_sample(self, cnt_input, mesh_hp=None, solver_hp=None, obj_fn=None):\
        doc, geom = self.build_sample_doc(cnt_input)\
        mesh = FiniteEleMeshHelper.build_t6_mesh_from_dxf(doc, hp=mesh_hp)\
        res = FiniteEleSolverHelper.solve(mesh, hp=solver_hp)\
        if obj_fn is not None:\
            score = float(obj_fn(res, mesh, geom))\
        else:\
            probes = res.get("probes") or \{\}\
            if probes:\
                first_pid = sorted(probes.keys())[0]\
                score = float(probes[first_pid].get("dxy", 0.0))\
            else:\
                score = float(np.max(res.get("u_mag", [0.0])))\
        return \{\
            "score": score,\
            "result": res,\
            "mesh": mesh,\
            "doc": doc,\
            "geom": geom,\
        \}\
\
    def plot_sample_preview(self, geom_data, ax=None):\
        created_fig = None\
        if ax is None:\
            created_fig, ax = plt.subplots(figsize=(8, 6))\
        ax.clear()\
        ax.set_facecolor("#0a0a0a")\
        if ax.figure is not None:\
            ax.figure.patch.set_facecolor("#0a0a0a")\
        auto_p = geom_data.get("auto_poly")\
        if auto_p is not None and not auto_p.is_empty:\
            auto_geoms = auto_p.geoms if isinstance(auto_p, MultiPolygon) else [auto_p]\
            auto_verts = [np.asarray(g.exterior.coords, dtype=float) for g in auto_geoms]\
            ax.add_collection(\
                PolyCollection(\
                    auto_verts,\
                    facecolors="#cc66ff",\
                    edgecolors="#cc66ff",\
                    alpha=0.15,\
                    linestyles="dashed",\
                    linewidths=1.4,\
                    zorder=2,\
                    label="AUTO Region",\
                )\
            )\
        filleted_cnt = geom_data.get("filleted_cnt_poly")\
        if filleted_cnt is not None and not filleted_cnt.is_empty:\
            cnt_geoms = filleted_cnt.geoms if isinstance(filleted_cnt, MultiPolygon) else [filleted_cnt]\
            cnt_verts = [np.asarray(g.exterior.coords, dtype=float) for g in cnt_geoms]\
            ax.add_collection(\
                PolyCollection(\
                    cnt_verts,\
                    facecolors="#ff5577",\
                    edgecolors="#ff5577",\
                    alpha=0.25,\
                    linestyles="dotted",\
                    linewidths=1.2,\
                    zorder=3,\
                    label="Filleted CNT Union",\
                )\
            )\
        all_loops = [(geom_data["outer_loop"], geom_data["outer_layers"])] + list(\
            zip(geom_data["hole_loops"], geom_data["hole_layers"])\
        )\
        segs_by_layer = \{\}\
        for loop, layers in all_loops:\
            n = len(loop)\
            for i in range(n):\
                lay = layers[i] if i < len(layers) else "0"\
                segs_by_layer.setdefault(lay, []).append((loop[i], loop[(i + 1) % n]))\
        for lay, segs in segs_by_layer.items():\
            style = DXFEditingHelper.get_layer_style(lay)\
            ax.add_collection(\
                LineCollection(\
                    segs,\
                    colors=style["colors"],\
                    linewidths=style["linewidths"],\
                    zorder=style["zorder"],\
                    label=f"Layer \{lay\}",\
                )\
            )\
        outer = geom_data["outer_loop"]\
        xmin, ymin = outer.min(axis=0)\
        xmax, ymax = outer.max(axis=0)\
        dx = max(xmax - xmin, 1.0) * 0.08\
        dy = max(ymax - ymin, 1.0) * 0.08\
        ax.set_xlim(xmin - dx, xmax + dx)\
        ax.set_ylim(ymin - dy, ymax + dy)\
        ax.set_aspect("equal", adjustable="datalim")\
        handles, labels = ax.get_legend_handles_labels()\
        if handles:\
            ax.legend(loc="lower right", facecolor="#181818", edgecolor="#444444", labelcolor="#dddddd", fontsize=8)\
        return created_fig, ax\
